{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doubao Murmur",
  "version": "0.1.0",
  "identifier": "com.doubao.murmur",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "lilong7676",
    "shortDescription": "豆包语音输入",
    "longDescription": "通过豆包 Web 版的语音识别能力实现 Windows 全局语音输入。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
