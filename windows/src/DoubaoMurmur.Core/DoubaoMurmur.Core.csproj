<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DoubaoMurmur.Core</RootNamespace>
    <AssemblyName>DoubaoMurmur.Core</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The NAudio metapackage drags in NAudio.WinForms, whose framework reference
         pulls the whole Microsoft.WindowsDesktop.App runtime (WPF + WinForms) into
         a self-contained publish — about 60 MB of assemblies this app never loads.
         Referencing just the two pieces that are used avoids all of it.

         Floating versions on purpose: this project is developed without a local
         Windows/dotnet toolchain, so pinning an exact patch that turns out not to
         exist would break restore on CI. -->
    <PackageReference Include="NAudio.Core" Version="2.2.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.*" />
  </ItemGroup>

</Project>
