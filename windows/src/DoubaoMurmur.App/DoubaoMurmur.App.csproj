<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DoubaoMurmur</RootNamespace>
    <AssemblyName>DoubaoMurmur</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!-- WinUI 3 has no AnyCPU configuration. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (plain .exe) deployment. EnableMsixTooling stays on even though
         nothing is packaged: that is the combination the WinUI 3 template ships,
         and the PRI/resource targets are wired up behind it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Ship the Windows App SDK and the .NET runtime with the app so users do not
         have to install either one. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating versions: this project is authored without a local Windows
         toolchain, so an exact pin that turns out not to exist would break restore. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoubaoMurmur.Core\DoubaoMurmur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI ships localized .mui resources for around 40 languages, roughly 15 MB.
       They only translate built-in control strings (text box context menus and the
       like); WinUI falls back to en-US for any language that is absent. -->
  <Target Name="TrimWinUiLanguageResources" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_MuiFile Include="$(PublishDir)**\*.mui" />
      <_MuiFileToKeep Include="@(_MuiFile)"
                      Condition="$([System.String]::new('%(RecursiveDir)').StartsWith('en-US')) Or $([System.String]::new('%(RecursiveDir)').StartsWith('zh-'))" />
      <_MuiFileToDrop Include="@(_MuiFile)" Exclude="@(_MuiFileToKeep)" />
    </ItemGroup>
    <Delete Files="@(_MuiFileToDrop)" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="@(_MuiFileToDrop->'%(RootDir)%(Directory)')" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Trimmed @(_MuiFileToDrop->Count()) localized WinUI resource files" />
  </Target>

</Project>
